---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import SectionContainer from "../components/ui/SectionContainer.astro";
---

<Layout
  title="Terms & Conditions"
  description="Tri State Awnings Terms & Conditions, including SMS Terms for our transactional and promotional text messaging programs: message types, frequency, rates, how to opt out (STOP), how to get help (HELP), and privacy."
>
  <Header />

  <!-- Hero Section -->
  <section class="relative w-full bg-gradient-to-br from-slate-800 to-slate-700 pt-32 pb-16 sm:pt-40 sm:pb-20">
    <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
    <SectionContainer class="relative z-10 text-white">
      <h1 class="font-semibold text-3xl sm:text-4xl md:text-5xl lg:text-[56px] leading-[110%] tracking-[-0.02em] mb-4">
        Terms &amp; Conditions
      </h1>
      <p class="text-lg sm:text-xl text-white/90 max-w-3xl">
        Last updated: November 25, 2026
      </p>
    </SectionContainer>
  </section>

  <!-- Content Section -->
  <section class="py-16 sm:py-20 md:py-24 bg-white">
    <SectionContainer>
      <div class="max-w-4xl mx-auto">
        <div class="terms-content">
          <div class="content-section">
            <p>
              These Terms &amp; Conditions are provided by Tri State Awnings, 100 Sterling Mine Rd., Sloatsburg, NY 10974 ("Tri State Awnings," "we," "our," or "us"), and govern the Tri State Awnings SMS messaging program.
            </p>
          </div>

          <div class="content-section" id="sms-terms">
            <h2>SMS Terms</h2>

            <h3>Tri State Awnings – Customer Messaging Program</h3>
            <p>
              Tri State Awnings is the owner and operator of this SMS messaging program. The program includes two types of messages. Each requires its own separate, optional consent, which you can give by checking the corresponding SMS consent box on our quote request form. You may agree to one, both, or neither.
            </p>

            <h3>Transactional Messages</h3>
            <p>
              If you opt in to transactional messages, you agree to receive non-promotional SMS messages from Tri State Awnings regarding:
            </p>
            <ul>
              <li>Appointment confirmations</li>
              <li>Installation reminders</li>
              <li>Project updates</li>
              <li>Service notifications</li>
              <li>Customer support</li>
            </ul>

            <h3>Promotional Messages</h3>
            <p>
              If you separately opt in to marketing messages, you agree to receive recurring promotional and marketing SMS messages from Tri State Awnings, which may be sent using automated technology, including:
            </p>
            <ul>
              <li>Special offers</li>
              <li>Seasonal discounts</li>
              <li>Promotions</li>
              <li>Marketing campaign updates</li>
            </ul>
            <p>
              We send promotional messages only to customers who have given marketing consent. Consenting to transactional messages does not enroll you in promotional messages.
            </p>

            <h3>Message Frequency</h3>
            <p>
              Message frequency varies depending on your project status, interactions with our team, and, if you have opted in to marketing messages, our current promotions.
            </p>

            <h3>Message and Data Rates</h3>
            <p>
              Message and data rates may apply.
            </p>

            <h3>Opt-Out Instructions</h3>
            <p>
              You may unsubscribe at any time by replying <strong>STOP</strong>. Replying STOP stops all SMS messages from Tri State Awnings, both transactional and promotional. You may receive a final confirmation message acknowledging your opt-out. No further messages will be sent unless you provide consent again. To stop only promotional messages while continuing to receive transactional messages, contact us using the information below.
            </p>

            <h3>Help and Customer Support</h3>
            <p>
              Reply <strong>HELP</strong> for assistance, or contact us directly:
            </p>
            <div class="contact-info">
              <p><strong>Tri State Awnings</strong></p>
              <p>100 Sterling Mine Rd., Sloatsburg, NY 10974</p>
              <p>Phone: <a href="tel:+18453575718">845-357-5718</a></p>
              <p>Email: <a href="mailto:sales@tristateawnings.com">sales@tristateawnings.com</a></p>
            </div>

            <h3>Consent</h3>
            <p>
              Consent to receive SMS messages, whether transactional or promotional, is voluntary and is not a condition of purchasing any product or service.
            </p>

            <h3>Carrier Disclaimer</h3>
            <p>
              Carriers are not liable for delayed or undelivered messages.
            </p>

            <h3>Privacy Policy</h3>
            <p>
              For information about how we collect, use, and protect your personal information, please review our <a href="/privacy-policy">Privacy Policy</a>. We do not sell or share your SMS opt-in data or personal information with third parties for marketing purposes.
            </p>
          </div>
        </div>
      </div>
    </SectionContainer>
  </section>

  <Footer />
</Layout>

<style>
  .terms-content {
    font-family: 'Urbanist', system-ui, sans-serif;
    color: #374151;
    line-height: 1.7;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .content-section:last-child {
    margin-bottom: 0;
  }

  .terms-content h2 {
    font-family: 'Urbanist', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.875rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #111827;
    margin-bottom: 1rem;
    margin-top: 2rem;
  }

  .content-section:first-child h2 {
    margin-top: 0;
  }

  .terms-content h3 {
    font-family: 'Urbanist', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #1f2937;
    margin-bottom: 0.75rem;
    margin-top: 1.5rem;
  }

  .terms-content p {
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .terms-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .terms-content li {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  .terms-content a {
    color: #68c28c;
    text-decoration: underline;
    transition: color 0.2s;
  }

  .terms-content a:hover {
    color: #5aad7a;
  }

  .contact-info {
    background-color: #f9fafb;
    border-left: 4px solid #68c28c;
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-top: 1rem;
  }

  .contact-info p {
    margin-bottom: 0.5rem;
  }

  .contact-info p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .terms-content h2 {
      font-size: 1.5rem;
    }

    .terms-content p {
      font-size: 0.9375rem;
    }
  }
</style>
