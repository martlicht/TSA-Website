---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import PergoloftHero from "../components/sections/pergoloft/PergoloftHero.astro";
import PergoloftIntro from "../components/sections/pergoloft/PergoloftIntro.astro";
import PergoloftFeatures from "../components/sections/pergoloft/PergoloftFeatures.astro";
import PergoloftShowcase from "../components/sections/pergoloft/PergoloftShowcase.astro";
import PergoloftSukkah from "../components/sections/pergoloft/PergoloftSukkah.astro";
import PergoloftBenefits from "../components/sections/pergoloft/PergoloftBenefits.astro";
import PergoloftGallery from "../components/sections/pergoloft/PergoloftGallery.astro";
import PergoloftFAQ from "../components/sections/pergoloft/PergoloftFAQ.astro";
import Testimonials from "../components/sections/landing/Testimonials.astro";
import ContactForm from "../components/sections/landing/ContactForm.astro";

const pergoloftTestimonials = [
	{
		quote: '"A game-changer for our outdoor living"',
		text: 'The Pergoloft has completely transformed how we use our backyard. Even during the rainiest weeks, we can still enjoy our morning coffee outside. The quality is exceptional.',
		author: '- Michael & Sarah T.',
	},
	{
		quote: '"Worth every penny"',
		text: 'We looked at traditional pergolas and fabric covers, but the Pergoloft was in a different league. The glass panels let in so much light while keeping us dry. Our neighbors are jealous!',
		author: '- David K., Westchester',
	},
	{
		quote: '"Professional from start to finish"',
		text: 'The Tri State team was incredible. From the consultation to the one-day installation, everything was seamless. The Pergoloft looks stunning and works perfectly.',
		author: '- Jennifer M., Long Island',
	},
];
---

<Layout title="Pergoloft - Premium Glass Pergola System | Tri State Awnings">
	<Header />
	<PergoloftHero />
	<PergoloftIntro />
	<PergoloftFeatures />
	<PergoloftShowcase />
	<PergoloftSukkah />
	<!-- <PergoloftBenefits /> -->
	<PergoloftGallery />
	<PergoloftFAQ />
	<!-- <Testimonials testimonials={pergoloftTestimonials} /> -->
	<ContactForm description="Experience Your Luxury Outdoor Space with PergoLoft" />
	<Footer />
</Layout>

<style>
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 0.6s;
		animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	::view-transition-old(root) {
		animation-name: pergoloft-slide-out;
	}

	::view-transition-new(root) {
		animation-name: pergoloft-slide-in;
	}

	::view-transition-group(*) {
		animation-duration: 0.6s;
		animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	::view-transition-group(gallery-image-0),
	::view-transition-group(gallery-image-1),
	::view-transition-group(gallery-image-2),
	::view-transition-group(gallery-image-3) {
		animation-duration: 0.8s;
		animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	::view-transition-group(pergoloft-gallery-header) {
		animation-duration: 0.7s;
		animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	::view-transition-group(pergoloft-see-more-button) {
		animation-duration: 0.5s;
		animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	@keyframes pergoloft-slide-out {
		from {
			opacity: 1;
			transform: translateX(0) scale(1);
		}
		to {
			opacity: 0;
			transform: translateX(20px) scale(0.98);
		}
	}

	@keyframes pergoloft-slide-in {
		from {
			opacity: 0;
			transform: translateX(-20px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateX(0) scale(1);
		}
	}
</style>
