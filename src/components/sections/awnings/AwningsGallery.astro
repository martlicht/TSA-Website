---
import { Image } from 'astro:assets';
import SectionContainer from '../../ui/SectionContainer.astro';
import Button from '../../ui/Button.astro';
import {
	allGalleryImages,
	previewLookImages,
	type AwningGalleryImage,
} from '../../../data/awningGallery';

const firstNonPreviewIndex = previewLookImages.length;

function columnCountsThree(n: number): [number, number, number] {
	if (n === 7) return [2, 3, 2];
	if (n === 9) return [3, 3, 3];
	const c1 = Math.ceil(n / 3);
	const rest = n - c1;
	const c2 = Math.ceil(rest / 2);
	const c3 = rest - c2;
	return [c1, c2, c3];
}

function splitLookPreviewColumns(items: AwningGalleryImage[]): [AwningGalleryImage[], AwningGalleryImage[], AwningGalleryImage[]] {
	const [a, b, c] = columnCountsThree(items.length);
	let i = 0;
	const col1 = items.slice(i, (i += a));
	const col2 = items.slice(i, (i += b));
	const col3 = items.slice(i, i + c);
	return [col1, col2, col3];
}

const [lookCol1, lookCol2, lookCol3] = splitLookPreviewColumns(previewLookImages);
const lookDesktopColumns = [lookCol1, lookCol2, lookCol3];
const lookColOffsets = [
	0,
	lookCol1.length,
	lookCol1.length + lookCol2.length,
];
---

<section id="gallery-section" class="py-12 sm:py-16 md:py-20 lg:py-24 bg-white">
	<SectionContainer>
		<div class="text-center mb-12 sm:mb-16" transition:name="gallery-header">
			<h2 class="scroll-fade-in font-sans font-semibold text-4xl sm:text-5xl lg:text-6xl mb-4 text-black">
				Envision the <span class="text-primary italic">Look</span>
			</h2>
			<p class="scroll-fade-in font-sans text-lg sm:text-xl text-gray-600" data-delay="1">
				Explore projects from customers who transformed their spaces with our roll-up awnings.
			</p>
		</div>

		<div class="mb-8 sm:mb-12">
			<!--
				Un solo bloque en el DOM (sin duplicar <Image> por breakpoint).
				Móvil: columnas apiladas (A,B → C,D,E → F,G). lg+: tres columnas en fila (mosaico por alturas).
				Sin transition:name en enlaces: evita conflictos con View Transitions.
			-->
			<div class="flex flex-col lg:flex-row gap-4 sm:gap-6 lg:gap-8 items-start">
				{lookDesktopColumns.map((column, colIdx) => (
					<div class="flex flex-col gap-4 sm:gap-6 lg:gap-8 flex-1 min-w-0 w-full">
						{column.map((image, i) => {
							const index = lookColOffsets[colIdx] + i;
							return (
								<div
									class="gallery-item scroll-fade-in w-full visible"
									data-look-index={index}
									style={`animation-delay: ${index * 50}ms;`}
								>
									<a
										href={`/awning-gallery-viewer?index=${index}`}
										class="gallery-image-wrapper w-full relative group cursor-pointer overflow-hidden rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 block"
										style={`aspect-ratio: ${image.aspectRatio}; min-height: 200px;`}
									>
										<Image
											src={image.src}
											alt={image.alt}
											width={image.width}
											height={image.height}
											class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
											loading="lazy"
											decoding="async"
											quality={85}
											format="webp"
										/>
										<div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 pointer-events-none"></div>
									</a>
								</div>
							);
						})}
					</div>
				))}
			</div>
		</div>

		{allGalleryImages.length > previewLookImages.length && (
			<div class="text-center mt-8 sm:mt-12">
				<a
					href={`/awning-gallery-viewer?index=${firstNonPreviewIndex}`}
					class="see-more-btn scroll-fade-in inline-block"
					data-delay="2"
					transition:name="see-more-button"
				>
					<Button variant="primary" size="lg">
						See more
					</Button>
				</a>
			</div>
		)}
	</SectionContainer>
</section>

<style>
	.gallery-item {
		opacity: 0;
		transform: translateY(30px);
		transition:
			opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		width: 100%;
	}

	.gallery-item.visible {
		opacity: 1;
		transform: translateY(0);
	}

	.gallery-item.hidden {
		display: none;
	}
</style>
