---
import { Image } from 'astro:assets';
import SectionContainer from '../../ui/SectionContainer.astro';
import featureImage from '../../../assets/images/pergoloft/pergoloft-image.webp';
import instantValueIcon from '../../../assets/icons/instant-value.svg';
import gearIcon from '../../../assets/icons/gear-icon.svg';
import sunLightIcon from '../../../assets/icons/sun-light.svg';
import adjustableIcon from '../../../assets/icons/adjutable-icon.svg';
import homeIcon from '../../../assets/icons/home-icon.svg';
---

<section id="features-section" class="py-16 sm:py-20 md:py-24 lg:py-32 bg-white">
	<SectionContainer>
		<div class="flex flex-col lg:flex-row gap-12 lg:gap-14 xl:gap-16 items-start lg:items-stretch max-w-6xl mx-auto">
			<!-- Left Column: Image -->
			<div class="w-full lg:w-[47%] order-2 lg:order-1 lg:self-stretch">
				<div class="rounded-[28px] overflow-hidden shadow-lg h-full">
					<Image
						src={featureImage}
						alt="Pergoloft glass pergola system showcasing modern design"
						class="w-full h-full object-cover aspect-[4/5] lg:aspect-auto"
						loading="lazy"
						quality={90}
						format="webp"
					/>
				</div>
			</div>

			<!-- Right Column: Content -->
			<div class="w-full lg:w-[53%] order-1 lg:order-2 lg:self-stretch">
				<span class="inline-block text-primary/80 font-medium text-sm uppercase tracking-[0.08em] mb-4">
					The Smart Investment
				</span>

				<h2 class="scroll-fade-in font-sans text-4xl sm:text-5xl md:text-[52px] font-normal mb-10 leading-[1.12] tracking-[-0.01em] text-gray-900 w-screen max-w-none ">
					Why Homeowners Choose <br />
					PergoLoft
				</h2>

				<!-- Features List -->
				<div class="space-y-8">
					<div class="scroll-fade-in flex gap-5 items-start" style="animation-delay: 100ms;">
						<div class="flex-shrink-0 w-14 h-14">
							<img src={instantValueIcon.src} alt="" class="w-full h-full object-contain" loading="lazy" />
						</div>
						<div>
							<h3 class="font-semibold text-xl sm:text-2xl text-gray-900 mb-1">Instant Value Addition</h3>
							<p class="text-gray-500 text-lg sm:text-[1.4rem] leading-relaxed">Increase your property value with a premium outdoor living space.</p>
						</div>
					</div>

					<div class="scroll-fade-in flex gap-5 items-start" style="animation-delay: 150ms;">
						<div class="flex-shrink-0 w-14 h-14">
							<img src={gearIcon.src} alt="" class="w-full h-full object-contain" loading="lazy" />
						</div>
						<div>
							<h3 class="font-semibold text-xl sm:text-2xl text-gray-900 mb-1">Engineered for Excellence</h3>
							<p class="text-gray-500 text-lg sm:text-[1.4rem] leading-relaxed">Structural aluminum construction built for long-term outdoor performance.</p>
						</div>
					</div>

					<div class="scroll-fade-in flex gap-5 items-start" style="animation-delay: 200ms;">
						<div class="flex-shrink-0 w-14 h-14">
							<img src={sunLightIcon.src} alt="" class="w-full h-full object-contain" loading="lazy" />
						</div>
						<div>
							<h3 class="font-semibold text-xl sm:text-2xl text-gray-900 mb-1">Natural Light Without Compromise</h3>
							<p class="text-gray-500 text-lg sm:text-[1.4rem] leading-relaxed">Polycarbonate side panels protect the space while maintaining brightness.</p>
						</div>
					</div>

					<div class="scroll-fade-in flex gap-5 items-start" style="animation-delay: 250ms;">
						<div class="flex-shrink-0 w-14 h-14">
							<img src={adjustableIcon.src} alt="" class="w-full h-full object-contain" loading="lazy" />
						</div>
						<div>
							<h3 class="font-semibold text-xl sm:text-2xl text-gray-900 mb-1">Adjustable Shade When You Need It</h3>
							<p class="text-gray-500 text-lg sm:text-[1.4rem] leading-relaxed">Roll-up awning fabric easily adjusts shade and coverage.</p>
						</div>
					</div>

					<div class="scroll-fade-in flex gap-5 items-start" style="animation-delay: 300ms;">
						<div class="flex-shrink-0 w-14 h-14">
							<img src={homeIcon.src} alt="" class="w-full h-full object-contain" loading="lazy" />
						</div>
						<div>
							<h3 class="font-semibold text-xl sm:text-2xl text-gray-900 mb-1">Made to Match Your Home</h3>
							<p class="text-gray-500 text-lg sm:text-[1.4rem] leading-relaxed">Custom sizes and finishes designed to complement your space.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</SectionContainer>
</section>
