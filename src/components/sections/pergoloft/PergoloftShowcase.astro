---
import { Image } from 'astro:assets';
import SectionContainer from '../../ui/SectionContainer.astro';
import showcaseImage from '../../../assets/images/pergoloft/pergoloft-image-a.webp';
---

<section class="relative py-20 sm:py-24 md:py-32 lg:py-40 overflow-hidden bg-gray-900">
	<!-- Background Image with overlay -->
	<div class="absolute inset-0">
		<Image 
			src={showcaseImage}
			alt="Pergoloft installation showcasing outdoor living space"
			class="w-full h-full object-cover opacity-40"
			loading="lazy"
			quality={80}
			format="webp"
		/>
		<div class="absolute inset-0 bg-gradient-to-b from-[#041b17]/85 via-[#0b2e27]/70 to-[#041b17]/85"></div>
	</div>

	<SectionContainer class="relative z-10">
		<div class="max-w-4xl mx-auto text-center">
			<!-- Headline -->
			<h2 class="scroll-fade-in font-sans text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight tracking-[-0.02em] text-white">
				365 Days of<br />
				<span class="text-primary italic">Weather Protection</span>
			</h2>

			<p class="scroll-fade-in text-lg sm:text-xl text-white/70 mb-12 max-w-2xl mx-auto leading-relaxed" style="animation-delay: 100ms;">
				Rain or shine, the Pergoloft transforms your outdoor space into a year-round sanctuary. Entertain guests, relax with family, or simply enjoy the view.
			</p>

			<!-- Unified Stats Card -->
			<div
				class="scroll-fade-in bg-white rounded-3xl p-6 sm:p-8 md:p-10 shadow-2xl"
				style="animation-delay: 200ms;"
			>
				<div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-primary/30">
					<div class="px-4 py-4 text-center">
						<span class="block text-5xl sm:text-6xl font-semibold text-primary mb-3">100%</span>
						<p class="text-gray-600 text-lg leading-tight">
							Customizable in colors, sizes and other features
						</p>
					</div>
					<div class="px-4 py-4 text-center">
						<span class="block text-5xl sm:text-6xl font-semibold text-primary mb-3">8-10</span>
						<p class="text-gray-600 text-lg leading-tight">
							years of frame and fabric warranty
						</p>
					</div>
					<div class="px-4 py-4 text-center">
						<span class="block text-5xl sm:text-6xl font-semibold text-primary mb-3">1</span>
						<p class="text-gray-600 text-lg leading-tight">
							day fast installation
						</p>
					</div>
				</div>
			</div>
		</div>
	</SectionContainer>
</section>
