---
import { getImage } from "astro:assets";
import SectionContainer from "../../ui/SectionContainer.astro";
import heroImage from "../../../assets/images/pergoloft/video-frame.webp";
import heroVideo from "../../../assets/images/pergoloft/pergoloft.mp4";

const poster = await getImage({
  src: heroImage,
  width: 1920,
  format: "webp",
});

const videoSrc =
  typeof heroVideo === "string"
    ? heroVideo
    : (heroVideo as { default?: string; src?: string }).default ??
      (heroVideo as { src: string }).src;
---

<section class="relative w-full min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <video
      class="pergoloft-hero-video h-full w-full object-cover object-center"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={poster.src}
      aria-label="Pergoloft glass roof system on modern patio"
      tabindex="-1"
      disablepictureinpicture
      disableRemotePlayback
    >
      <source src={videoSrc} type="video/mp4" />
    </video>

    <div
      class="pergoloft-hero-static absolute inset-0 h-full w-full bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${poster.src}')`}
      aria-hidden="true"
    >
    </div>

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent"
    >
    </div>
  </div>

  <SectionContainer class="relative z-10 pt-32 sm:pt-40 md:pt-48 pb-20">
    <div class="mx-auto text-center">
      <h1
        class="font-sans text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-medium mb-8 leading-[1.05] tracking-[-0.02em] text-white animate-fade-in-up"
      >
        The PergoLoft
      </h1>

      <p
        class="hero-description text-white mb-10 max-w-4xl mx-auto animate-fade-in-up animation-delay-100"
      >
        The latest awning innovation from Tri-State Awnings, the PergoLoft
        combines awning functionality with a luxurious pergola aesthetic.
      </p>

      <div class="flex justify-center animate-fade-in-up animation-delay-200">
        <a
          href="#contact-form-section"
          class="inline-flex items-center justify-center px-10 py-4 text-lg font-medium text-white bg-black/30 border-2 border-white rounded-xl hover:bg-black/40 transition-colors"
        >
          Get yours!
        </a>
      </div>
    </div>
  </SectionContainer>
</section>

<style>
  .hero-description {
    font-family: "Urbanist", system-ui, sans-serif;
    font-weight: 400;
    font-size: 26px;
    line-height: 140%;
    letter-spacing: -0.005em;
  }

  .pergoloft-hero-static {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pergoloft-hero-video {
      display: none;
    }

    .pergoloft-hero-static {
      display: block;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }

  .animation-delay-100 {
    animation-delay: 0.1s;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
    opacity: 0;
  }
</style>
