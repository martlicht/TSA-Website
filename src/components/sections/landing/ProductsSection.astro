---
import ProductCard from "../../ui/ProductCard.astro";
import ProductBannerCard from "../../ui/ProductBannerCard.astro";
import SectionContainer from "../../ui/SectionContainer.astro";
import awningImage from "../../../assets/images/awning.webp";
/** Placeholder — swap this import for your architectural canopies asset */
import architecturalCanopiesImage from "../../../assets/images/canopie-product.png";
import pergoloftImage from "../../../assets/images/pergoloft/pergoloft-product.png";
import sukkahImage from "../../../assets/images/sukkah-product.png";

interface Product {
  title: string;
  description: string;
  image: typeof awningImage;
  href: string;
  showIcon?: boolean;
  isExternal?: boolean;
}

const products: Product[] = [
  {
    title: "Awnings",
    description:
      "Durable, roll-up awnings that extend and roll away smoothly to keep your outdoor space cool, comfortable, and protected.",
    image: awningImage,
    href: "/awnings",
    showIcon: false,
    isExternal: false,
  },
  {
    title: "Pergoloft",
    description:
      "A premium pergola system with polycarbonate panels and awning coverage for natural light and year-round protection.",
    image: pergoloftImage,
    href: "/pergoloft",
    showIcon: false,
    isExternal: false,
  },
  {
    title: "The Instant Sukkah",
    description:
      "A ready-made Sukkah that sets up in seconds and stays sturdy, offering a beautiful space for a stress-free holiday.",
    image: sukkahImage,
    href: "https://theinstantsukkah.com/",
    showIcon: true,
    isExternal: true,
  },
];
---

<section
  id="products-section"
  class="py-12 sm:py-16 md:py-20 lg:py-24 bg-white"
>
  <SectionContainer>
    <!-- Headline -->
    <h2
      class="scroll-fade-in text-center font-medium text-[2rem] sm:text-[2.5rem] lg:text-[64px] leading-[130%] tracking-[-0.02em] mb-8 sm:mb-12 md:mb-16"
    >
      The Most Innovative{" "}
      <br />
      <span class="text-primary">Awning</span> and{" "}
      <span class="text-primary">Sukkah</span>
      Company.
    </h2>

    <!-- Products Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-[34px] items-stretch"
    >
      {
        products.map((product, index) => (
          <div
            class="scroll-fade-in h-full"
            style={`animation-delay: ${index * 100}ms;`}
          >
            <ProductCard
              title={product.title}
              description={product.description}
              image={product.image}
              href={product.href}
              showIcon={product.showIcon}
              isExternal={product.isExternal}
              class="h-full"
            />
          </div>
        ))
      }
    </div>

    <div class="mt-6 sm:mt-8 lg:mt-[34px] scroll-fade-in">
      <ProductBannerCard
        title="Architectural Canopies"
        description="Explore outdoor solutions designed for restaurants, businesses, and commercial spaces."
        image={architecturalCanopiesImage}
        href="https://apexcanopies.com/"
      />
    </div>
    <!-- Full-width banner -->
  </SectionContainer>
</section>
