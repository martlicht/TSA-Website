---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  href: string;
  isExternal?: boolean;
  class?: string;
}

const {
  title,
  description,
  image,
  href,
  isExternal = false,
  class: className = "",
} = Astro.props;
---

<article class={`product-banner-card ${className}`}>
  <div
    class="product-banner-inner relative w-full min-h-[260px] sm:min-h-[300px] md:min-h-[320px] overflow-hidden rounded-[14px] border border-black/[0.1]"
  >
    <Image
      src={image}
      alt={title}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 hover:scale-105"
      loading="lazy"
    />
    <div class="pointer-events-none absolute inset-0 product-banner-gradient" aria-hidden="true">
    </div>
    <div
      class="relative z-10 flex min-h-[260px] flex-col justify-end gap-6 p-6 sm:min-h-[300px] sm:p-8 md:min-h-[320px] md:flex-row md:items-end md:justify-between"
    >
      <div class="max-w-2xl">
        <h3
          class="product-banner-title mb-2 text-2xl font-semibold tracking-[-0.01em] text-white sm:text-3xl md:text-4xl"
        >
          {title}
        </h3>
        <p
          class="product-banner-description text-sm leading-[150%] tracking-[-0.002em] text-white/95 sm:text-base md:text-lg"
        >
          {description}
        </p>
      </div>
      <a
        href={href}
        class="product-banner-button inline-flex w-fit shrink-0 items-center justify-center rounded-full border-2 border-white px-5 py-2.5 text-sm font-medium text-white transition-colors duration-300 hover:bg-white hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-transparent sm:px-6 sm:py-3 sm:text-base"
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
        data-astro-prefetch={isExternal ? undefined : "hover"}
      >
        Learn more →
      </a>
    </div>
  </div>
</article>

<style>
  .product-banner-card {
    width: 100%;
  }

  .product-banner-inner {
    box-shadow:
      0 8px 28px rgba(0, 0, 0, 0.04),
      0 16px 48px rgba(0, 0, 0, 0.05);
    transition: box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .product-banner-card:hover .product-banner-inner {
    box-shadow:
      0 12px 36px rgba(0, 0, 0, 0.06),
      0 24px 56px rgba(0, 0, 0, 0.07);
  }

  .product-banner-title,
  .product-banner-description {
    font-family: "Inter", system-ui, sans-serif;
  }

  /* Sombra solo abajo: arriba transparente, abajo oscuro para contraste del texto */
  .product-banner-gradient {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0) 38%,
      rgba(0, 0, 0, 0.45) 72%,
      rgba(0, 0, 0, 0.78) 100%
    );
  }
</style>
