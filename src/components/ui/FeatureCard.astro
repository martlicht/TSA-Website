---
interface Props {
	number: string;
	title: string;
	description: string;
	delay?: number;
}

const { number, title, description, delay = 0 } = Astro.props;
---

<div
	class="feature-card bg-white/85 backdrop-blur-sm rounded-[24px] flex flex-col transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md shadow-sm w-full max-w-full px-5 py-6 gap-2 sm:w-[277px] sm:max-w-[277px] sm:shrink-0 sm:px-[38.54px] sm:py-[21px] sm:h-[354px] sm:gap-[9px] sm:justify-start"
	style={`animation-delay: ${delay}ms;`}
>
	<!-- Number / title: smaller on mobile, Figma 40px from sm -->
	<div class="text-3xl leading-none font-bold text-[#68C28C] sm:text-[40px] sm:leading-[40px]">
		{number}
	</div>

	<h3 class="text-3xl leading-tight font-bold text-[#68C28C] sm:text-[40px] sm:leading-[40px]">
		{title}
	</h3>

	<p class="text-base font-normal text-[#717972] leading-relaxed">
		{description}
	</p>
</div>

